# Groq API Key for server-side evaluation (never exposed to client)
# Get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq chat model supporting JSON mode
# Check the model list at https://console.groq.com/docs/models and replace the default if it has been retired.
LLM_MODEL=qwen/qwen3.8-27b

# Reasoning Effort for Groq models: "none", "low", "medium", "high".
# IMPORTANT: Thinking mode wastes output tokens on this app (which can quickly exhaust the OTPM limit).
# Set to "none" for reasoning models (e.g. qwen/qwen3.8-27b) so that thinking tokens are omitted.
# Leave empty for standard non-reasoning models (which reject reasoning_effort).
LLM_REASONING_EFFORT=none

# Optional Fallback Model if primary model exceeds limits or fails (e.g. llama-3.3-70b-versatile)
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Max output tokens per job (lower than OTPM limit to fit within token limits)
# Job A (recited-sentence finder): default 250
LLM_MAX_TOKENS_A=250
# Job B (key-point checker): default 400
LLM_MAX_TOKENS_B=400
# Job C (follow-up writer): default 150
LLM_MAX_TOKENS_C=150

# Output tokens per minute (OTPM) budget tracker limit (rolling 60-second window, default 900)
LLM_OTPM_LIMIT=900

# Supabase Project Configuration
SUPABASE_URL=https://wlyyyvookdbhdlimnbrq.supabase.co
SUPABASE_KEY=sb_publishable_sGH465-rZXaeJrGaonMj7g_rnN8Zvpc

# Supabase Postgres connection string (Server-side only. Never expose to the browser.)
# Get this from Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Format: postgresql://postgres.wlyyyvookdbhdlimnbrq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.wlyyyvookdbhdlimnbrq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Server Port
PORT=3000
